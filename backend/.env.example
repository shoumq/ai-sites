# Приложение
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]

# База данных / кэш
DATABASE_URL=postgresql+asyncpg://ai_sites:ai_sites@localhost:5432/ai_sites
REDIS_URL=redis://localhost:6379/0

# AI-провайдер — Yandex AI Studio (YandexGPT + YandexART), единственный
# провайдер ИИ во всём проекте (бриф, подбор блоков, картинки, ИИ-чат).
# Оставьте пустыми для mock-режима.
# YANDEX_API_KEY — API-ключ из aistudio.yandex.ru (Api-Key), YANDEX_FOLDER_ID — id каталога.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest
YANDEX_ART_MODEL=yandex-art/latest

# S3-совместимое хранилище (VK Cloud / Yandex Cloud)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai-sites-builds
S3_REGION=ru-central1
PUBLIC_BASE_DOMAIN=builder.ai
# Откуда браузер разработчика реально достучится до бэкенда (mock-публикация)
PUBLIC_BACKEND_URL=http://localhost:8000

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Микросервис статической сборки сайтов (docker-compose поднимает его сам)
SITE_BUILDER_URL=http://site-builder:4000
