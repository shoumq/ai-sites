# Приложение
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:5173"]

# База данных / кэш
DATABASE_URL=postgresql+asyncpg://ai_sites:ai_sites@localhost:5432/ai_sites
REDIS_URL=redis://localhost:6379/0

# AI-провайдеры — оставьте пустыми для работы в mock-режиме без внешних вызовов
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
KANDINSKY_API_KEY=
KANDINSKY_SECRET_KEY=

# S3-совместимое хранилище (VK Cloud / Yandex Cloud)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai-sites-builds
S3_REGION=ru-central1
PUBLIC_BASE_DOMAIN=builder.ai

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
