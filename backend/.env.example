# Приложение
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:5173"]

# База данных / кэш
DATABASE_URL=postgresql+asyncpg://ai_sites:ai_sites@localhost:5432/ai_sites
REDIS_URL=redis://localhost:6379/0

# AI-провайдер — Yandex AI Studio (llm.api.cloud.yandex.net). Оставьте пустыми
# для работы в mock-режиме без внешних вызовов. Нужны оба значения сразу:
# API-ключ создаётся в AI Studio (aistudio.yandex.ru), folder_id — id каталога
# Yandex Cloud, в котором он выпущен.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite
YANDEX_ART_MODEL=yandex-art

# S3-совместимое хранилище (VK Cloud / Yandex Cloud)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai-sites-builds
S3_REGION=ru-central1
PUBLIC_BASE_DOMAIN=builder.ai

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
